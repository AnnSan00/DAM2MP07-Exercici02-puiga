<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="rootPane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="750.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.project.MainController">
   <top>
      <AnchorPane prefHeight="70.0" prefWidth="200.0" style="-fx-background-color: #1976D2;" BorderPane.alignment="CENTER">
         <children>
            <Label alignment="CENTER" layoutX="20.0" layoutY="15.0" text="Nintendo DB" textFill="WHITE" AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="15.0">
               <font>
                  <Font name="System Bold" size="28.0" />
               </font>
            </Label>
         </children>
      </AnchorPane>
   </top>
   <center>
      <StackPane BorderPane.alignment="CENTER">
         <children>
            <!-- 1. VISTA ESCRIPTORI -->
            <HBox fx:id="desktopView" spacing="15.0">
               <padding>
                  <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
               </padding>
               <children>
                  <!-- Panel de navegació esquerre -->
                  <VBox prefWidth="220.0" spacing="10.0">
                     <children>
                        <ComboBox fx:id="cmbCategory" maxWidth="1.7976931348623157E308" promptText="Selecciona categoria" />
                        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                           <content>
                              <VBox fx:id="vboxList" spacing="8.0">
                                 <padding>
                                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                 </padding>
                              </VBox>
                           </content>
                        </ScrollPane>
                     </children>
                  </VBox>
                  <!-- Detall de l'element -->
                  <VBox alignment="TOP_CENTER" spacing="15.0" HBox.hgrow="ALWAYS">
                     <children>
                        <ImageView fx:id="imgDetail" fitHeight="220.0" fitWidth="350.0" pickOnBounds="true" preserveRatio="true" />
                        <Label fx:id="lblTitle" text="Selecciona un element" wrapText="true">
                           <font>
                              <Font name="System Bold" size="22.0" />
                           </font>
                        </Label>
                        <Label fx:id="lblDescription" text="Descripció de l'element seleccionat." wrapText="true" VBox.vgrow="ALWAYS" />
                     </children>
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </VBox>
               </children>
            </HBox>

            <!-- 2. VISTA MÒBIL -->
            <VBox fx:id="mobileView" alignment="CENTER" spacing="20.0" visible="false">
               <padding>
                  <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
               </padding>
               <children>
                  <Button maxWidth="1.7976931348623157E308" prefHeight="55.0" style="-fx-font-size: 18px; -fx-background-color: #E0E0E0;" text="Personatges" />
                  <Button maxWidth="1.7976931348623157E308" prefHeight="55.0" style="-fx-font-size: 18px; -fx-background-color: #E0E0E0;" text="Jocs" />
                  <Button maxWidth="1.7976931348623157E308" prefHeight="55.0" style="-fx-font-size: 18px; -fx-background-color: #E0E0E0;" text="Consoles" />
               </children>
            </VBox>
         </children>
      </StackPane>
   </center>
</BorderPane>